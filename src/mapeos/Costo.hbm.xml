<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="datos.Costo" table="costo">
        <id name="id" column="id">
            <generator class="identity"/>
        </id>
        <property name="costoSuperficies" column="costo_superficies" type="int" />
        <property name="costoMontaje" column="costo_montaje" type="int"/>
        <property name="plusElectricidad" column="plus_electricidad" type="int" />
        <property name="sueldoBase" column="sueldo_base" type="int" />
    </class>
</hibernate-mapping>
